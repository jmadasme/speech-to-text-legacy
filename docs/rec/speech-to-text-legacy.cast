[149.287, "o", "\u001b[90m 247\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mwhile\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(g_running)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[149.342, "o", "\u001b[90m 248\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[90m/* GetMessage espera hasta que llegue un mensaje. Retorna 0\u001b[39;49;00m\n"]
[149.397, "o", "\u001b[90m 249\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m         \u001b[39;49;00m*\u001b[90m \u001b[39;49;00mcuando\u001b[90m \u001b[39;49;00mrecibe\u001b[90m \u001b[39;49;00mWM_QUIT\u001b[90m \u001b[39;49;00m(posteado\u001b[90m \u001b[39;49;00mpor\u001b[90m \u001b[39;49;00mPostQuitMessage).\u001b[90m \u001b[39;49;00m*/\u001b[90m\u001b[39;49;00m\n"]
[149.452, "o", "\u001b[90m 250\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[96mint\u001b[39;49;00m\u001b[90m \u001b[39;49;00mret\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mGetMessage(&msg,\u001b[90m \u001b[39;49;00m\u001b[96mNULL\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[149.507, "o", "\u001b[90m 251\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(ret\u001b[90m \u001b[39;49;00m==\u001b[90m \u001b[39;49;00m\u001b[94m0\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[149.562, "o", "\u001b[90m 252\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[90m/* WM_QUIT recibido */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[149.617, "o", "\u001b[90m 253\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m            \u001b[39;49;00m\u001b[94mbreak\u001b[39;49;00m;\u001b[90m\u001b[39;49;00m\n"]
