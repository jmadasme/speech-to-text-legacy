[28.51, "o", "\u001b[90m 127\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m/* -------------------------------------------------------------- */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.565, "o", "\u001b[90m 128\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m/*  3. Inicializar COM (apartamento multi-hilo)                   */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.62, "o", "\u001b[90m 129\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[90m/* -------------------------------------------------------------- */\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.675, "o", "\u001b[90m 130\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mhr\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mCoInitializeEx(\u001b[96mNULL\u001b[39;49;00m,\u001b[90m \u001b[39;49;00mCOINIT_MULTITHREADED);\u001b[90m\u001b[39;49;00m\n"]
[28.73, "o", "\u001b[90m 131\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(FAILED(hr))\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
